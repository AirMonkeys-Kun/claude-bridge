{
    "rules":  [
                  {
                      "id":  "cmd-escape-ampersand",
                      "description":  "cmd.exe 模式下 \u0026\u0026 会被当作命令分隔符，需要用 ^\u0026^\u0026 转义",
                      "triggers":  {
                                       "type":  "cmd",
                                       "pattern_in_command":  "\u0026\u0026"
                                   },
                      "fix":  {
                                  "action":  "escape",
                                  "find":  "\u0026\u0026",
                                  "replace_with":  "^\u0026^\u0026"
                              },
                      "example_before":  "echo hello \u0026\u0026 whoami",
                      "example_after":  "echo hello ^\u0026^\u0026 whoami",
                      "hits":  14,
                      "created":  "2026-05-31"
                  },
                  {
                      "id":  "ps-wsl-semicolon",
                      "description":  "PowerShell 模式下 ; 会被 PowerShell 解释为语句分隔符，不会传给 bash",
                      "triggers":  {
                                       "type":  "powershell",
                                       "command_contains":  "wsl -e bash -c",
                                       "pattern_in_command":  ";"
                                   },
                      "fix":  {
                                  "action":  "wrap_single_quotes",
                                  "description":  "将 bash -c 后面的参数用单引号包裹，而不是双引号"
                              },
                      "example_before":  "wsl -e bash -c \"echo hello; whoami\"",
                      "example_after":  "wsl -e bash -c \u0027echo hello; whoami\u0027",
                      "hits":  0,
                      "created":  "2026-05-31"
                  },
                  {
                      "id":  "ps-wsl-pipe",
                      "description":  "PowerShell 模式下 | 可能被 PowerShell 解释为管道",
                      "triggers":  {
                                       "type":  "powershell",
                                       "command_contains":  "wsl -e bash -c",
                                       "pattern_in_command":  "|"
                                   },
                      "fix":  {
                                  "action":  "wrap_single_quotes",
                                  "description":  "确保 bash -c 的参数用单引号包裹，阻止 PowerShell 解析 |"
                              },
                      "example_before":  "wsl -e bash -c \"cat file | head -3\"",
                      "example_after":  "wsl -e bash -c \u0027cat file | head -3\u0027",
                      "hits":  0,
                      "created":  "2026-05-31"
                  },
                  {
                      "id":  "cmd-wsl-nested-quotes",
                      "description":  "cmd.exe 模式下 WSL 命令里的嵌套引号会被 cmd 错误解析",
                      "triggers":  {
                                       "type":  "cmd",
                                       "command_contains":  "wsl -e bash -c \"",
                                       "pattern_in_command":  "\\\""
                                   },
                      "fix":  {
                                  "action":  "change_type",
                                  "to_type":  "powershell",
                                  "description":  "带 WSL 嵌套引号的命令改为 powershell 类型执行"
                              },
                      "example_before":  "type=cmd, command=wsl -e bash -c \"echo hi\"",
                      "example_after":  "type=powershell, command=wsl -e bash -c \u0027echo hi\u0027",
                      "hits":  0,
                      "created":  "2026-05-31"
                  },
                  {
                      "id":  "clixml-stderr-filter",
                      "description":  "自动过滤 PowerShell CLIXML 进度输出噪声，避免假阳性错误记录",
                      "triggers":  {
                                       "type":  "any"
                                   },
                      "fix":  {
                                  "action":  "clixml_filter",
                                  "description":  "在 Log-ExecutionError 中应用 Filter-CLIXML 去除 CLIXML XML 进度块"
                              },
                      "hits":  0,
                      "auto_generated":  false,
                      "active":  true,
                      "created":  "2026-06-03"
                  },
                  {
                      "id":  "ps-double-ampersand-to-cmd",
                      "description":  "PowerShell 不支持 \u0026\u0026 操作符，遇到时自动切换为 cmd 类型执行，避免解析错误",
                      "triggers":  {
                                       "type":  "powershell",
                                       "pattern_in_command":  "\u0026\u0026"
                                   },
                      "fix":  {
                                  "action":  "change_type",
                                  "to_type":  "cmd",
                                  "description":  "含 \u0026\u0026 的命令改为 cmd 类型执行"
                              },
                      "hits":  2,
                      "created":  "2026-06-03",
                      "example_before":  "type=powershell, command=cd dir \u0026\u0026 python main.py",
                      "example_after":  "type=cmd, command=cd dir \u0026\u0026 python main.py"
                  },
                  {
                      "id":  "ps-fstring-format-to-cmd",
                      "description":  "PowerShell 解释器会拦截 Python f-string 的 :\u003cN\u003e 格式说明符，导致自定义错误，改为 cmd 执行",
                      "triggers":  {
                                       "type":  "powershell",
                                       "command_contains":  "python -c",
                                       "pattern_in_command":  ":\u003c"
                                   },
                      "fix":  {
                                  "action":  "change_type",
                                  "to_type":  "cmd",
                                  "description":  "含 Python f-string 格式符的命令改为 cmd 类型执行"
                              },
                      "hits":  2,
                      "created":  "2026-06-03",
                      "example_before":  "type=powershell, command=$env:X=\u0027val\u0027; python -c \"print(f\\\"{\u0027model\u0027:\u003c35}\\\")\"",
                      "example_after":  "type=cmd, command=$env:X=\u0027val\u0027; python -c \"print(f\\\"{\u0027model\u0027:\u003c35}\\\")\""
                  },
                  {
                      "id":  "ps-start-process-to-powershell",
                      "description":  "Start-Process 是 PowerShell cmdlet，在 cmd 下不可用，自动切换为 powershell 类型",
                      "triggers":  {
                                       "type":  "cmd",
                                       "pattern_in_command":  "Start-Process"
                                   },
                      "fix":  {
                                  "action":  "change_type",
                                  "to_type":  "powershell",
                                  "description":  "含 Start-Process 的命令改为 powershell 类型执行"
                              },
                      "hits":  1,
                      "created":  "2026-06-03",
                      "example_before":  "type=cmd, command=Start-Process -FilePath ...",
                      "example_after":  "type=powershell, command=Start-Process -FilePath ..."
                  },
                  {
                      "id":  "ps-env-dollar-underscore",
                      "description":  "$env:$_ 在 PowerShell 中是无效语法，修复为 ${env:$_} 避免变量解析错误",
                      "triggers":  {
                                       "type":  "powershell",
                                       "command_contains":  "$env:$_"
                                   },
                      "fix":  {
                                  "action":  "escape",
                                  "find":  "$env:$_",
                                  "replace_with":  "${env:$_}"
                              },
                      "hits":  2,
                      "created":  "2026-06-03",
                      "example_before":  "$keys|%{...$v=$env:$_...}",
                      "example_after":  "$keys|%{...$v=${env:$_}...}"
                  },
                  {
                      "id":  "ps-dollar-pid-colon-underscore",
                      "description":  "$pid: $_ 在 PowerShell 中被解释为作用域变量引用，导致解析错误，修复为 $($pid): $_",
                      "triggers":  {
                                       "type":  "powershell",
                                       "command_contains":  "$pid: $_"
                                   },
                      "fix":  {
                                  "action":  "escape",
                                  "find":  "$pid: $_",
                                  "replace_with":  "$($pid): $_"
                              },
                      "hits":  1,
                      "created":  "2026-06-03",
                      "example_before":  "catch { Write-Output \"Failed: $pid: $_\" }",
                      "example_after":  "catch { Write-Output \"Failed: $($pid): $_\" }"
                  },
                  {
