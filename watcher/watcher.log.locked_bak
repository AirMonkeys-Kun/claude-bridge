2026-06-07 22:27:30.171 | [clean_ba] type=__INLINE__ cmd=# Kill all extra bridge_agent instances except one;$target=netstat -ano|Select-String ':19850 '; Write-Output ('Found ' + $target.Count + ' instances'); $pids=@(); foreach($t in $target){$parts=$t -split '\s+'; $pids+=[int]$parts[-1]}; Write-Output ('PIDs: ' + ($pids -join ',')); # Keep oldest surviving instance (first in list); if($pids.Count -gt 1){$keep=$pids[0]; foreach($p in $pids[1..($pids.Count-1)]){try{Stop-Process -Id $p -Force -ErrorAction SilentlyContinue; Write-Output ('Killed ' + $p)}catch{Write-Output ('Failed kill ' + $p)}}}; Write-Output ('Kept PID ' + $keep) timeout=15s
