2026-06-03 23:54:27.988 | [audit4] type=powershell cmd=$wdir = 'D:\zebbingo\tools\claude-bridge\watcher'
$content = Get-Content "$wdir\watcher.ps1" -Raw
# Find the actual assignment lines for queueEvent and resultEvent
$lines = $content -split "`r`n"
$out = ""
foreach ($l in $lines) {
    $n = $lines.IndexOf($l) + 1
    if ($l -match 'queueEvent|resultEvent' -and $l -notmatch '^\s*#') {
        $out += "$n`: $l`n"
    }
}
# Also check: what does the polling loop look like?
$pollIdx = $lines | ForEach-Object {$i=0} {if ($_ -match 'Start-Sleep.*200|polling|queueEvent\s*=') {$i} $i++} | Select-Object -First 5
if ($out.Length -eq 0) { $out = "No active queueEvent/resultEvent references found" }
$out += "`nPOLL_CHECK:" + ($content -match 'Events disabled.*pure polling').ToString()
$out += "`nHAS_EVENTWAITHANDLE_CODE:" + ($content -match 'System\.Threading\.EventWaitHandle').ToString()
$out | Set-Content "$wdir\_audit3.txt" -Encoding UTF8 timeout=15s
