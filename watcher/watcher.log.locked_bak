2026-06-03 23:53:55.873 | [audit3] type=powershell cmd=$wdir = 'D:\zebbingo\tools\claude-bridge\watcher'
$log = Get-Content "$wdir\watcher.log" -Raw
# Find the LAST "Bridge" startup line
$lines = $log -split "`r`n"
$lastStart = $lines | Where-Object { $_ -match 'Bridge v\d+.*STARTED' } | Select-Object -Last 1
$out = "LAST_START: " + $lastStart
# Find last Queue Event / Result Event lines
$lastQE = $lines | Where-Object { $_ -match 'Queue Event' } | Select-Object -Last 1
$out += "`nLAST_QE: " + $lastQE
$lastRE = $lines | Where-Object { $_ -match 'Result Event' } | Select-Object -Last 1
$out += "`nLAST_RE: " + $lastRE
# Find last "Ready" lines
$lastReady = $lines | Where-Object { $_ -match 'Ready.*event|Ready.*poll' } | Select-Object -Last 1
$out += "`nLAST_READY: " + $lastReady
# Last 3 lines overall
$out += "`nLAST3:" + [string]::Join("|||", $lines[-3..-1])
$out | Set-Content "$wdir\_audit2.txt" -Encoding UTF8 timeout=15s
