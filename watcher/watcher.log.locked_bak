2026-06-03 23:53:11.386 | [audit2] type=powershell cmd=$wdir = 'D:\zebbingo\tools\claude-bridge\watcher'
$out = @()
$log = Get-Content "$wdir\watcher.log" -Tail 3 -EA SilentlyContinue
$out += "LOG:" + [string]::Join("|||", $log)
$hb = Get-Content "$wdir\.watcher_heartbeat" -Raw -EA SilentlyContinue
$out += "HB:" + $hb.Trim()
$pidStr = Get-Content "$wdir\.watcher.lock" -Raw -EA SilentlyContinue
$out += "PID:" + $pidStr.Trim()
$content = Get-Content "$wdir\watcher.ps1" -Raw
if ($content -match 'Bridge (v\d+)') { $out += "VER:" + $matches[1] }
if ($content -match 'Events disabled') { $out += "POLLING:True" } else { $out += "POLLING:False" }
$out += "CONTAINS_EventWaitHandle:" + ($content -match 'EventWaitHandle').ToString()
$out += "CONTAINS_queueEvent:" + ($content -match '\$script:queueEvent').ToString()
$li = Get-Item "$wdir\watcher.log" -EA SilentlyContinue
if ($li) { $out += "LOGSIZE:" + $li.Length; $out += "LOGMOD:" + $li.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss") }
$out -join "`n" | Set-Content "$wdir\_audit.txt" -Encoding UTF8 timeout=15s
