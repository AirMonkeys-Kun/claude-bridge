2026-06-07 22:24:11.266 | [fix_all] type=__INLINE__ cmd=# Clean orphan workers;$poolFile='D:\zebbingo\tools\claude-bridge\cluster\.worker_pool.json';$pool=Get-Content $poolFile -Raw -Encoding UTF8|ConvertFrom-Json;foreach($w in $pool.workers){try{Stop-Process -Id $w.pid -Force -ErrorAction SilentlyContinue}catch{}};$pool.workers=@();$pool|ConvertTo-Json|Set-Content $poolFile -Encoding UTF8;Write-Output 'Workers cleaned';function Test-Port($p){try{$r=New-Object Net.Sockets.TcpClient;$r.Connect('127.0.0.1',$p);$r.Close();return $true}catch{return $false}};$b=if(Test-Port 19850){'UP'}else{'DOWN'};$p=if(Test-Port 4000){'UP'}else{'DOWN'};Write-Output "bridge_agent=$b proxy=$p";if($b -eq 'DOWN'){$np=Start-Process -NoNewWindow -PassThru python 'D:\zebbingo\tools\claude-bridge\bridge_agent.py' -WorkingDirectory 'D:\zebbingo\tools\claude-bridge';Start-Sleep -Seconds 2;Write-Output "Started ba PID=$($np.Id)"};if($p -eq 'DOWN'){$np2=Start-Process -NoNewWindow -PassThru python 'D:\zebbingo\tools\claude-desktop-config\proxy\server.py' -WorkingDirectory 'D:\zebbingo\tools\claude-desktop-config\proxy';Start-Sleep -Seconds 3;Write-Output "Started proxy PID=$($np2.Id)"};Start-Sleep -Seconds 2;$b2=if(Test-Port 19850){'UP'}else{'DOWN'};$p2=if(Test-Port 4000){'UP'}else{'DOWN'};Write-Output "Final: bridge_agent=$b2 proxy=$p2" timeout=45s
