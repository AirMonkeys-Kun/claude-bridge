$clusterDir = 'D:\zebbingo\tools\claude-bridge\cluster'
function Start-One($name) {
    $d = Join-Path $clusterDir $name
    $s = Join-Path $d 'worker.ps1'
    $r = Join-Path $d 'runner.ps1'
    if (Test-Path $s) {
        Start-Process -FilePath powershell.exe -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$s`" -WorkerDir `"$d`"" -WindowStyle Hidden
        Write-Host "  STARTED $name"
    } elseif (Test-Path $r) {
        Start-Process -FilePath powershell.exe -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$r`"" -WindowStyle Hidden
        Write-Host "  STARTED $name (runner)"
    } else {
        Write-Host "  SKIP $name (no script)"
    }
}
foreach ($w in $workers) { Start-One $w }
Start-Sleep 3
foreach ($w in $workers) {
    $hb = Join-Path $clusterDir "$w\.heartbeat"
    if (Test-Path $hb) {
        Write-Host "  [OK] $w: $(Get-Content $hb -Raw)"
    } else {
        Write-Host "  [--] $w: no heartbeat"
    }
}
