2026-06-07 21:59:10.757 | [c_b8a5912cc316] type=powershell_text cmd=
$dir = "D:\zebbingo\tools\claude-bridge"
$p = Start-Process -NoNewWindow -PassThru python "$dir\bridge_agent.py" -WorkingDirectory $dir
