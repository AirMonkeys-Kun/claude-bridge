2026-06-07 22:34:58.268 | [t_afa82946fb56] type=powershell cmd=
powershell -NoProfile -Command "
  `$proxyDir = 'D:/zebbingo/tools/claude-desktop-config/proxy'
  Write-Output 'STARTING GUARDIAN'
  `$PID | Out-File (`$proxyDir + '/proxy_guardian.pid') -Encoding ascii -Force
  Write-Output 'PID WRITTEN'
  Get-Date | Out-File (`$proxyDir + '/proxy_guardian.heartbeat') -Encoding ascii -Force
  Write-Output 'HB WRITTEN'
  # Loop
  `$i = 0
  while (`$i -lt 3) {
    `$i++
    Start-Sleep 2
    Get-Date | Out-File (`$proxyDir + '/proxy_guardian.heartbeat') -Encoding ascii -Force
    Write-Output 'beat ' + `$i
  }
  Write-Output 'GUARDIAN END'
"
 timeout=20s
