2026-06-06 19:47:53.606 | [restart_f1ff6b18] type=powershell cmd=
$proc = Get-NetTCPConnection -LocalPort 19850 -State Listen -ErrorAction SilentlyContinue
if ($proc) {
    $pid = $proc.OwningProcess
    "Killing bridge_agent PID=$pid"
    Stop-Process -Id $pid -Force
    Start-Sleep -Seconds 2
    $check = Get-NetTCPConnection -LocalPort 19850 -State Listen -ErrorAction SilentlyContinue
    if ($check) {
        "Already restarted: PID=$($check.OwningProcess)"
    } else {
        "Stopped. Guardian V3 will restart within 60s."
    }
} else {
    "No bridge_agent process found on port 19850"
}
