2026-06-06 21:16:06.731 | [t_1cfbdd37ab6f] type=powershell cmd=
function Test-ProcessAlive {
    param([int]$TargetPid)
    if (-not $TargetPid) { return $false }
    try { $p = Get-Process -Id $TargetPid -ErrorAction Stop; return $true }
    catch { return $false }
}
$gpid = [int]6976
"gpid: $gpid type: " + $gpid.GetType().FullName
