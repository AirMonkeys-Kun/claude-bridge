2026-06-06 19:34:15.797 | [fix_6e821c58] TRANSFORMED: '
$task = Get-ScheduledTask -TaskName 'ClaudeBridgeAgent'
$info = Get-ScheduledTaskInfo -TaskName 'ClaudeBridgeAgent'
$settings = $task.Settings
@{
    State = $task.State.ToString()
    LastRunTime = if($info.LastRunTime -gt [datetime]::MinValue){$info.LastRunTime.ToString('yyyy-MM-dd HH:mm:ss')}else{'Never'}
    LastResult = $info.LastTaskResult
    ExecutionTimeLimit = $settings.ExecutionTimeLimit
    MultipleInstances = $settings.MultipleInstances.ToString()
    RestartOnFailure = $settings.RestartCount
    # Check if bridge_agent is actually running
    AgentRunning = [bool](Get-NetTCPConnection -LocalPort 19850 -State Listen -ErrorAction SilentlyContinue)
    AgentPid = try { (Get-NetTCPConnection -LocalPort 19850 -State Listen -ErrorAction SilentlyContinue).OwningProcess } catch { 'N/A' }
} | ConvertTo-Json
