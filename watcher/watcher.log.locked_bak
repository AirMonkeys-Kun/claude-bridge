2026-06-07 23:01:03.239 | [t_1aa6c6f3feff] type=powershell cmd=
$procs = Get-CimInstance Win32_Process -Filter "Name = 'python.exe'" | Where-Object { $_.CommandLine -match 'server\.py' }
$procs | ForEach-Object { Write-Output "kill $($_.ProcessId)"; Stop-Process -Id $_.ProcessId -Force }
Start-Sleep 2
$env:PYTHONIOENCODING = "utf-8"
Start-Process python -ArgumentList "D:\zebbingo\tools\claude-desktop-config\proxy\server.py" -WorkingDirectory "D:\zebbingo\tools\claude-desktop-config\proxy" -NoNewWindow
Start-Sleep 4
try { $r = Invoke-WebRequest -Uri "http://127.0.0.1:4000/health" -UseBasicParsing -TimeoutSec 5; "OK: $($r.Content)" } catch { "FAIL: $_" }
 timeout=15s
