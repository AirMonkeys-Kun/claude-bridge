2026-06-07 00:44:42.540 | [c_faa14735d28a] type=powershell_text cmd=
    $bridgeDir = "D:\zebbingo\tools\claude-bridge"
    # Start new bridge_agent first (will bind port 19850)
    $p = Start-Process -NoNewWindow -PassThru -FilePath "python" -ArgumentList "$bridgeDir\bridge_agent.py" -WorkingDirectory $bridgeDir
    Write-Output "New bridge_agent PID=$($p.Id) started"
    Start-Sleep -Seconds 2
    # Kill old bridge_agent (find by script name)
    Get-Process python -ErrorAction SilentlyContinue | Where-Object {
        try { (Get-CimInstance -Class Win32_Process -Filter "ProcessId=$($_.Id)").CommandLine -match "bridge_agent.py" } catch { $false }
    } | ForEach-Object {
        Write-Output "Killing old PID=$($_.Id)"
        $_.Kill()
    }
    Write-Output "Restart complete"
   timeout=30s
