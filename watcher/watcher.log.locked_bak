2026-06-05 10:10:36.564 | [stop_clean] type=system_1 cmd=# Stop proxy
$proc = Get-Process -Name python -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like "*proxy*" }
if ($proc) { Write-Output "Stopping proxy PID $($proc.Id)..."; Stop-Process -Id $proc.Id -Force; Start-Sleep 1; Write-Output "Stopped" } else { Write-Output "No proxy running" }

# Delete locked logs from bridge root
$root = "D:\zebbingo\tools\claude-bridge"
@("proxy_debug.log","proxy_audit.log","proxy_stderr.log","proxy_stdout.log") | ForEach-Object {
    $p = "$root\$_"
    if (Test-Path $p) { Remove-Item -Path $p -Force; Write-Output "Deleted root $_" } else { Write-Output "$_ not found" }
}

# Move legacy README dirs out of the way — merge into docs/legacy/
$legacyDir = "$root\docs\legacy"
New-Item -ItemType Directory -Force -Path $legacyDir | Out-Null

@("backend-integration","frontend-integration","profile-system","startup-scripts") | ForEach-Object {
    $src = "$root\$_"
    if (Test-Path $src) {
        # Read the README content for historical record
        $readme = Get-Content "$src\README.md" -Raw -ErrorAction SilentlyContinue
        # Write a summary to docs/legacy
        "# $_`n`nOriginally in root of claude-bridge (initial commit 854acbb, 2026-06-01).`n`nStub directory with only README.md — retained for historical reference.`n" | Out-File "$legacyDir\$_.md" -Encoding utf8
        Remove-Item -Path $src -Recurse -Force
        Write-Output "Removed $_/ (saved note to docs/legacy/$_.md)"
    }
}

Write-Output ""
Write-Output "=== Final bridge root listing ==="
Get-ChildItem $root -Name | Sort-Object | ForEach-Object { Write-Output "  $_" } timeout=30s
