2026-06-07 00:51:28.273 | [c_9bab82fb5fa8] type=powershell_text cmd=
$dir = "D:\zebbingo\tools\claude-bridge"

# Kill all old watchdog processes (everything --parent-pid that isnt the new bridge_agent)
Get-Process python -ErrorAction SilentlyContinue | Where-Object {
    try {
        $c = Get-CimInstance Win32_Process -Filter "ProcessId=$($_.Id)"
        $c.CommandLine -match "bridge_agent_watchdog"
    } catch { $false }
} | ForEach-Object { Write-Output "Kill watchdog PID=$($_.Id)"; $_.Kill() }

# Start NEW bridge_agent
$p = Start-Process -NoNewWindow -PassThru -FilePath "python" -ArgumentList "$dir\bridge_agent.py" -WorkingDirectory $dir
Write-Output "New bridge_agent PID=$($p.Id)"

Start-Sleep -Seconds 2

# Kill old bridge_agent instances (but not the new one)
Get-Process python -ErrorAction SilentlyContinue | Where-Object {
    try {
        $c = Get-CimInstance Win32_Process -Filter "ProcessId=$($_.Id)"
        ($c.CommandLine -match "bridge_agent.py") -and ($c.ProcessId -ne $p.Id) -and ($c.CommandLine -notmatch "watchdog")
    } catch { $false }
} | ForEach-Object { Write-Output "Kill old bridge_agent PID=$($_.Id)"; $_.Kill() }

Write-Output "Done"
 timeout=30s
