2026-06-07 22:12:01.218 | [diag1] type=powershell cmd=$result=@{}; # check bridge_agent
 try { $c=New-Object Net.Sockets.TcpClient; $c.Connect('127.0.0.1',19850); $result.ba='LISTENING'; $c.Close() } catch { $result.ba='DOWN' }
 # check health port
 try { $c=New-Object Net.Sockets.TcpClient; $c.Connect('127.0.0.1',19851); $result.health='LISTENING'; $c.Close() } catch { $result.health='DOWN' }
 # check bridge_agent process
 $ps=Get-Process python* -ErrorAction SilentlyContinue; $result.python_count=$ps.Count
 # output as JSON
 ConvertTo-Json $result
 # also write to known file
 $result | Format-List | Out-File 'D:\zebbingo\tools\claude-bridge\results\diag1_out.txt'
 Write-Output "---DIAG-DONE---" timeout=20s
