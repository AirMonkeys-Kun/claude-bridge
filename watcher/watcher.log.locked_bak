2026-06-06 19:26:23.390 | [fix_8b78706a] TRANSFORMED: '
$task = Get-ScheduledTask -TaskName 'ClaudeBridgeAgent' -ErrorAction SilentlyContinue
if (-not $task) { 
    'NOT FOUND' 
} else {
    $info = Get-ScheduledTaskInfo -TaskName 'ClaudeBridgeAgent' -ErrorAction SilentlyContinue
    $action = $task.Actions[0]
    $trigger = $task.Triggers[0]
    $settings = $task.Settings
    @{
        TaskName = $task.TaskName
        State = $task.State.ToString()
        Execute = $action.Execute
        Arguments = $action.Arguments
        WorkingDir = $action.WorkingDirectory
        TriggerType = $trigger.CimClass.CimClassName
        TriggerStart = if($trigger.StartBoundary) { $trigger.StartBoundary } else { 'N/A' }
        Enabled = $task.State -ne 2  # 2 = Disabled
        RunAs = $task.Principal.UserId
        RunLevel = $task.Principal.RunLevel.ToString()
        LastRunTime = if($info.LastRunTime -gt [datetime]::MinValue) { $info.LastRunTime.ToString('yyyy-MM-dd HH:mm:ss') } else { 'Never' }
        LastResult = $info.LastTaskResult
        LastExitCode = try { [Convert]::ToInt32($info.LastTaskResult, 16) } catch { $info.LastTaskResult }
        RestartCount = $settings.RestartCount
        RestartInterval = $settings.RestartInterval
    } | ConvertTo-Json -Depth 3
}
' -> '
