import asyncio, json, wave, sys, os, time, secrets
sys.path.insert(0, 'src')
from libs.mqttclient import MQTTClientWrapper

wav_path = 'tests/asr/testdata/mqtt_vad_capture_input.wav'
with wave.open(wav_path, 'rb') as w:
    sr = w.getframerate()
    ch = w.getnchannels()
    audio = w.readframes(w.getnframes())
print('WAV: %d bytes, %dHz, %dch' % (len(audio), sr, ch))

session_id = secrets.token_urlsafe(9)[:12]
turn_id = '1'
device_id = 'full-link-test'
base = 'development/%s' % device_id
start_ts = time.time()

responses = []

def on_msg(client, userdata, msg):
    responses.append((str(msg.topic), len(msg.payload)))
    topic = str(msg.topic)
    payload_size = len(msg.payload)
    print('MQTT_RECV: %s (%d bytes)' % (topic, payload_size))
    if payload_size < 2048:
        try:
            data = json.loads(msg.payload.decode('utf-8'))
            print('  PAYLOAD: %s' % json.dumps(data, ensure_ascii=False)[:200])
        except Exception:
            pass

client = MQTTClientWrapper(name='test', host='localhost', port=1883, username='', password='', on_message=on_msg)
client.start(background=True)
time.sleep(1)

client.subscribe('%s/response/#' % base, qos=1)
time.sleep(0.5)
print('SUBSCRIBED')

payload = {'turn_proto': 1, 'audio': {'codec': 'pcm', 'sr': sr, 'channels': ch}}
client.publish(json.dumps(payload), topic='%s/request/session/%s/start' % (base, session_id), qos=1)
print('SESSION_START: %s' % session_id)

time.sleep(5)
print('INTRO_WAIT_DONE, responses_so_far=%d' % len(responses))

client.publish(
    json.dumps({'codec': 'pcm', 'sr': sr, 'channels': ch}),
    topic='%s/request/audio/%s/%s/start' % (base, session_id, turn_id),
    qos=1
)
print('AUDIO_START')

fp = 320
total_chunks = 0
for i in range(0, len(audio), fp):
    chunk = audio[i:i+fp]
    seq = i // fp + 1
    client.publish(chunk, topic='%s/request/audio/%s/%s/chunk/%d' % (base, session_id, turn_id, seq), qos=0)
    total_chunks = seq

print('Published %d chunks' % total_chunks)

duration_ms = int(len(audio) / (sr * ch * 2) * 1000)
client.publish(
    json.dumps({'total_seq': total_chunks, 'duration_ms': duration_ms}),
    topic='%s/request/audio/%s/%s/eos' % (base, session_id, turn_id),
    qos=1
)
print('EOS sent, waiting 20s for responses...')

time.sleep(20)

client.publish(
    json.dumps({'ts': int(time.time() * 1000)}),
    topic='%s/request/session/%s/end' % (base, session_id),
    qos=1
)
print('SESSION_END')
print()
print('=== RESULTS (%d total) ===' % len(responses))
for t, sz in responses:
    print('  %s: %d bytes' % (t, sz))
client.stop()
