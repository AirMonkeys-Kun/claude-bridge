from faster_whisper import WhisperModel
import wave
with wave.open(\"tests/asr/testdata/mqtt_vad_capture_input.wav\", \"rb\") as w:
    audio = w.readframes(w.getnframes())
print(f\"Audio: {len(audio)} bytes\")
model = WhisperModel(\"tiny\", device=\"cpu\", compute_type=\"int8\", cpu_threads=4)
segments, info = model.transcribe(audio, language=\"zh\")
text = \" \".join(seg.text for seg in segments)
print(f\"Transcription: {text[:100]}\")
print(\"STT_OK\")
" 2>&1 timeout=60s
