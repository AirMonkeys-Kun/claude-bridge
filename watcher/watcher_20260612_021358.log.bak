2026-06-11 17:44:14.568 | [analyze_test_audio] type=wsl cmd=cd /home/administrator/projects/chatbot && echo '=== ASR test WAV ===' && ffprobe -hide_banner tests/asr/testdata/mqtt_vad_capture_asr.wav 2>&1 && echo '=== RMS level ===' && ffmpeg -i tests/asr/testdata/mqtt_vad_capture_asr.wav -af 'volumedetect' -f null - 2>&1 | grep -E 'mean_volume|max_volume|RMS' && echo '=== Input test WAV ===' && ffprobe -hide_banner tests/asr/testdata/mqtt_vad_capture_input.wav 2>&1 | head -5 && echo '=== Talking WAV ===' && ffprobe -hide_banner src/assets/talking.wav 2>&1 | head -5 && echo '=== try stt direct ===' && python3 -c "
import numpy as np
from faster_whisper import WhisperModel
import time
model = WhisperModel('tiny', device='cpu', compute_type='int8')
with open('/tmp/test_audio.raw', 'rb') as f:
    audio = np.frombuffer(f.read(), dtype=np.int16).astype(np.float32) / 32768.0
t0 = time.time()
segments, info = model.transcribe(audio, beam_size=5, language='zh')
text = ' '.join(s.text for s in segments)
elapsed = time.time() - t0
print(f'Duration: {len(audio)/16000:.2f}s')
print(f'Language: {info.language} (p={info.language_probability:.2f})')
print(f'Text: [{text}]')
print(f'Elapsed: {elapsed:.1f}s')
" 2>&1 timeout=60s
