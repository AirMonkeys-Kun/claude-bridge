model = WhisperModel('tiny', device='cpu', compute_type='int8', cpu_threads=4)
print('LOAD OK')
# Transcribe using a proper WAV file
import urllib.request
urllib.request.urlretrieve('https://github.com/SYSTRAN/faster-whisper/raw/master/tests/data/hieronymus_praetorius_puer_natus_in_bethlehem.wav', '/tmp/test.wav')
segments, info = model.transcribe('/tmp/test.wav', language='en')
text = ' '.join(s.text for s in segments)
print(f'TRANSCRIBE OK: {text[:100]}')
print(f'LANG: {info.language}')
print('SUCCESS')
" 2>&1 | tail -20 timeout=180s
