2026-06-11 17:44:37.164 | [test_stt_venv] type=wsl cmd=cd /home/administrator/projects/chatbot && source .venv/bin/activate && echo '=== Test talking.wav ===' && ffmpeg -y -i src/assets/talking.wav -f s16le -acodec pcm_s16le -ar 16000 -ac 1 /tmp/talking.raw 2>/dev/null && python3 -c "
import numpy as np
from faster_whisper import WhisperModel
import time
model = WhisperModel('tiny', device='cpu', compute_type='int8')
print('Model loaded')
for label, path in [('talking', '/tmp/talking.raw'), ('asr_test', '/tmp/test_audio.raw')]:
    with open(path, 'rb') as f:
        data = f.read()
    audio = np.frombuffer(data, dtype=np.int16).astype(np.float32) / 32768.0
    print(f'{label}: {len(data)} bytes, {len(audio)/16000:.2f}s')
    t0 = time.time()
    segments, info = model.transcribe(audio, beam_size=5, language=None)
    text = ' '.join(s.text for s in segments)
    elapsed = time.time() - t0
    print(f'  Lang: {info.language} (p={info.language_probability:.2f})')
    print(f'  Text: [{text}]')
    print(f'  Time: {elapsed:.1f}s')
" 2>&1 timeout=60s
