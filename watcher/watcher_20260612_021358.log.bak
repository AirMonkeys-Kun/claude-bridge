2026-06-11 17:47:36.901 | [debug_stt_format] type=wsl cmd=cd /home/administrator/projects/chatbot && source .venv/bin/activate && python3 -c "
import numpy as np
from faster_whisper import WhisperModel
model = WhisperModel('tiny', device='cpu', compute_type='int8')
print('Model loaded')
with open('/tmp/test_audio.raw', 'rb') as f:
    data = f.read()
# STAGE POOL path: int16 directly (like stt_pool.py does)
audio_int16 = np.frombuffer(data, dtype=np.int16)
print(f'int16: shape={audio_int16.shape}, dtype={audio_int16.dtype}')
s1, info1 = model.transcribe(audio_int16, beam_size=5, language=None)
text1 = ' '.join(s.text for s in s1)
print(f'int16 result: [{text1}] lang={info1.language}')

# CORRECT path: normalize to float32
audio_f32 = audio_int16.astype(np.float32) / 32768.0
print(f'f32: shape={audio_f32.shape}, dtype={audio_f32.dtype}')
s2, info2 = model.transcribe(audio_f32, beam_size=5, language=None)
text2 = ' '.join(s.text for s in s2)
print(f'f32 result: [{text2}] lang={info2.language}')
" 2>&1 timeout=60s
