import json, wave, time, secrets, sys
sys.path.insert(0, 'src')
from libs.mqttclient import MQTTClientWrapper

wav_path = 'tests/asr/testdata/mqtt_vad_capture_input.wav'
with wave.open(wav_path, 'rb') as w:
    sr = w.getframerate()
    ch = w.getnchannels()
    audio = w.readframes(w.getnframes())
print('WAV: %d bytes %dHz %dch' % (len(audio), sr, ch))

session_id = secrets.token_urlsafe(9)[:12]
device_id = 'full-link-test'
base = 'development/%%s' %% device_id

responses = []
def on_msg(c, u, m):
    t = str(m.topic)
    responses.append((t, len(m.payload)))
    print('MQTT_RECV: %%s (%%d bytes)' %% (t, len(m.payload)))
    try:
        d = json.loads(m.payload.decode())
        print('  DATA: %%s' %% json.dumps(d, ensure_ascii=False)[:200])
    except: pass

client = MQTTClientWrapper(name='ft', host='localhost', port=1883, username='', password='', on_message=on_msg)
client.start(background=True)
time.sleep(1)
client.subscribe('%%s/response/#' %% base, qos=1)
time.sleep(0.5)
print('SUBSCRIBED')

payload = {'turn_proto': 1, 'audio': {'codec': 'pcm', 'sr': sr, 'channels': ch}}
client.publish(json.dumps(payload), topic='%%s/request/session/%%s/start' %% (base, session_id), qos=1)
print('SESSION_START: %%s' %% session_id)

time.sleep(3)
print('INTRO_WAIT_DONE, responses=%%d' %% len(responses))

client.publish(json.dumps({'codec':'pcm','sr':sr,'channels':ch}), topic='%%s/request/audio/%%s/1/start' %% (base, session_id), qos=1)
print('AUDIO_START')

fp = 320
total = 0
for i in range(0, len(audio), fp):
    seq = i//fp+1
    client.publish(audio[i:i+fp], topic='%%s/request/audio/%%s/1/chunk/%%d' %% (base, session_id, seq), qos=0)
    total = seq
print('Published %%d chunks' %% total)

dur = int(len(audio)/(sr*ch*2)*1000)
client.publish(json.dumps({'total_seq':total,'duration_ms':dur}), topic='%%s/request/audio/%%s/1/eos' %% (base, session_id), qos=1)
print('EOS sent, waiting 15s...')

time.sleep(15)

client.publish(json.dumps({'ts':int(time.time()*1000)}), topic='%%s/request/session/%%s/end' %% (base, session_id), qos=1)
print('SESSION_END')
print()
print('=== RESULTS (%%d total) ===' %% len(responses))
for t, sz in responses:
    print('  %%s: %%d bytes' %% (t, sz))
client.stop()
