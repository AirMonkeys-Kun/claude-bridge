2026-06-10 14:58:45.282 | [write_test_script] type=powershell_text cmd=wsl -d Ubuntu -u administrator bash -lc 'cat > /tmp/full_link_test.py << '"'"'ENDOFFILE'"'"'
import asyncio, json, wave, sys, os, time, secrets
sys.path.insert(0, "/home/administrator/projects/chatbot/src")
from libs.mqttclient import MQTTClientWrapper

wav_path = "/home/administrator/projects/chatbot/tests/asr/testdata/mqtt_vad_capture_input.wav"
with wave.open(wav_path, "rb") as w:
    sr = w.getframerate()
    ch = w.getnchannels()
    audio = w.readframes(w.getnframes())
print(f"WAV: {len(audio)} bytes, {sr}Hz, {ch}ch")

session_id = secrets.token_urlsafe(9)[:12]
turn_id = "1"
device_id = "full-link-test"
base = f"development/{device_id}"

client = MQTTClientWrapper(name="test", host="localhost", port=1883, username="", password="")
responses = []

def on_msg(client, userdata, msg):
    responses.append((msg.topic, len(msg.payload)))
    print(f"MQTT_RECV: {msg.topic} ({len(msg.payload)} bytes)")

client._on_message = on_msg
client.start(background=True)
time.sleep(1)

client.subscribe(f"{base}/response/#", qos=1)
time.sleep(0.5)
print("SUBSCRIBED")

payload = {"turn_proto": 1, "audio": {"codec": "pcm", "sr": sr, "channels": ch}}
client.publish(json.dumps(payload), topic=f"{base}/request/session/{session_id}/start", qos=1)
print(f"SESSION_START: {session_id}")

time.sleep(5)
print(f"INTRO_WAIT_DONE, responses_so_far={len(responses)}")

client.publish(json.dumps({"codec": "pcm", "sr": sr, "channels": ch}), topic=f"{base}/request/audio/{session_id}/{turn_id}/start", qos=1)
print("AUDIO_START")

fp = 320
for i in range(0, len(audio), fp):
    chunk = audio[i:i+fp]
    seq = i // fp + 1
    client.publish(chunk, topic=f"{base}/request/audio/{session_id}/{turn_id}/chunk/{seq}", qos=0)
total_chunks = (len(audio) + fp - 1) // fp
print(f"Published {total_chunks} chunks")

duration_ms = int(len(audio) / sr / ch / 2 * 1000)
client.publish(json.dumps({"total_seq": total_chunks, "duration_ms": duration_ms}), topic=f"{base}/request/audio/{session_id}/{turn_id}/eos", qos=1)
print("EOS sent")

time.sleep(15)

client.publish(json.dumps({"ts": int(time.time()*1000)}), topic=f"{base}/request/session/{session_id}/end", qos=1)
print(f"SESSION_END, total_responses={len(responses)}")
for t, sz in responses:
    print(f"  {t}: {sz} bytes")
client.stop()
ENDOFFILE
echo "SCRIPT_WRITTEN_OK"' timeout=15s
